# Local development. In Vercel, set this to your Render backend URL + /api.
VITE_API_BASE_URL=http://localhost:5000/api

# Firebase Web App configuration (public client values; safe for frontend).
# These are NOT private API secrets. Get them from Firebase Console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Optional: browser-local Whisper model. No API key is required.
VITE_WHISPER_MODEL=Xenova/whisper-tiny

# Optional: a phone number owned/authorized by you for judge-demo marketplace call buttons.
# Do not put a private person's number here. Leave blank to disable demo calls.
VITE_DEMO_CONTACT_PHONE=
