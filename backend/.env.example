PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
ALLOW_VERCEL_PREVIEWS=true

# Groq is the ONLY generative-AI provider used by Farmora.
# Keep this key on Render/backend only. Never use a VITE_* variable for it.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Optional live mandi prices
AGMARKNET_API_KEY=

# Existing voice providers (not used for Sevak's text/image reasoning)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_HI=
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_MR_SPEAKER=priya
